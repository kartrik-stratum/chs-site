# ---------------------------------------------------------------
# Caliber Bath Designer – environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------

# Where new form submissions are e-mailed (the website owner)
OWNER_EMAIL=owner@example.com
# Optional extra recipient(s), comma separated
OWNER_CC=

# SMTP server (Gmail/Google Workspace: smtp.gmail.com:587 with an App Password;
# Microsoft 365: smtp.office365.com:587; SendGrid: smtp.sendgrid.net:587 user "apikey")
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
# true for port 465 (implicit TLS). Leave empty to auto-detect from the port.
SMTP_SECURE=
# Force STARTTLS on port 587 (recommended in production)
SMTP_REQUIRE_TLS=true

# "From" address on notifications (defaults to SMTP_USER). Must be allowed by your SMTP provider.
MAIL_FROM="Caliber Bath Designer <your-email@example.com>"

# Time zone used for the submission date/time in the e-mail
OWNER_TIMEZONE=America/Denver
# Embed the customer's selected product images in the e-mail
EMAIL_INCLUDE_IMAGES=true

# Public site address. Canonical URLs, sitemap and robots use it; pages are only
# indexable (robots "index") when the request host matches this host.
SITE_URL=https://caliberhsolutions.com

# Server
PORT=3000
NODE_ENV=production
# Set to 1 when running behind one reverse proxy / load balancer (Nginx, Render, Heroku...)
TRUST_PROXY=

# Spam protection
RATE_LIMIT_MAX=8
MIN_FORM_FILL_MS=3000
